# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS. Use * to allow all (dev only).
CORS_ORIGIN=*

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
# Local example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auto_pal?schema=public"

# ── Auth (JWT) ────────────────────────────────────────────────────────────
# Generate strong secrets, e.g.  openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Google Sign-In ────────────────────────────────────────────────────────
# Comma-separated Google OAuth client IDs to accept (the app's iOS/Android/Web
# client IDs). Leave empty to disable the /auth/google endpoint.
GOOGLE_CLIENT_IDS=
